{
  "name": "netatmo-indicator",
  "version": "1.6.15",
  "private": true,
  "description": "See your CO₂ level in the browser toolbar",
  "license": "MPL-2.0",
  "repository": "github:freaktechnik/netatmo-indicator",
  "homepage": "https://github.com/freaktechnik/netatmo-indicator#readme",
  "bugs": "https://github.com/freaktechnik/netatmo-indicator/issues",
  "author": "Martin Giger (https://humanoids.be)",
  "type": "module",
  "main": "./background.js",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "lint:js": "eslint *.js manifest.json package.json",
    "lint:webext": "web-ext lint",
    "lint:css": "stylelint *.css",
    "test": "npm run lint:js && npm run lint:webext && npm run lint:css",
    "build": "web-ext build",
    "start": "web-ext run"
  },
  "keywords": [
    "webextension",
    "netatmo"
  ],
  "devDependencies": {
    "@freaktechnik/eslint-config-extension": "^14.1.0",
    "eslint": "^10.14.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "web-ext": "^10.8.0"
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "plugins": [
      "stylelint-no-unsupported-browser-features"
    ],
    "rules": {
      "color-named": "always-where-possible",
      "plugin/no-unsupported-browser-features": true
    }
  },
  "browserslist": [
    "last 1 Firefox versions",
    "last 1 FirefoxAndroid versions",
    "Firefox ESR"
  ],
  "webExt": {
    "ignoreFiles": [
      "package.json",
      "package-lock.json",
      "README.md"
    ]
  }
}
